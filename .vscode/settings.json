{
    // تفعيل LanguageTool
    "languagetool.enabled": true,

    // اللغة: auto باش يكتاشف الفرنسية والإنجليزية بوحدو
    "languagetool.language": "auto",

    // تصحيح التعليقات في code
    "languagetool.checkComments": true,

    // تصحيح النصوص داخل strings
    "languagetool.checkStrings": true,

    // تصحيح نصوص Markdown
    "languagetool.checkMarkdown": true,

    // Highlight suggestions تلقائياً
    "languagetool.highlightStyle": "underline",

    // استعمل النسخة المجانية عبر السيرفر الافتراضي
    "languagetool.serverUrl": "",

    // عدد الاقتراحات المراد عرضها لكل خطأ
    "languagetool.maxNumberOfSuggestions": 3
}
